# Copy to .env.local and fill in. Never commit real values.

# Required: OpenRouter key (https://openrouter.ai/keys). Free models: 20 req/min, 50 req/day.
OPENROUTER_API_KEY=

# Optional: generation model (must exist on OpenRouter). Check free models with:
#   curl -s https://openrouter.ai/api/v1/models | jq -r '.data[].id | select(endswith(":free"))'
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Optional: model for the LLM stand-in evaluator (defaults to OPENROUTER_MODEL).
OPENROUTER_EVAL_MODEL=

# Evaluator: "llm" (stand-in, default) or "jev" (needs JEV_API_KEY).
EVALUATOR=llm
JEV_BASE_URL=https://api.typesafe.ai
JEV_API_KEY=
JEV_MODEL=jev-1.13.0

# Required in production: password for the HTTP Basic auth gate (any username).
APP_PASSWORD=

# Optional: public URL, sent to OpenRouter as HTTP-Referer.
APP_URL=
