{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specforge.dev/schemas/rubric.schema.json",
  "title": "SpecForge evaluation rubric",
  "type": "object",
  "required": ["rubric_version", "evaluator_model", "state_contract", "categories", "gates", "checks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "rubric_version": { "$ref": "#/$defs/semver" },
    "evaluator_model": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "state_contract": {
      "type": "object",
      "required": ["format", "fields"],
      "properties": {
        "format": { "const": "json" },
        "fields": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "key", "type", "instructions"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^gate\\.[a-z_]+$" },
          "version": { "type": "integer", "minimum": 1 },
          "key": { "$ref": "#/$defs/jevKey" },
          "type": { "const": "noul" },
          "instructions": { "type": "string" },
          "criteria": { "$ref": "#/$defs/noulCriteria" }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "slug": { "type": "string", "pattern": "^[a-z][a-z_]*$" },
    "checkId": { "type": "string", "pattern": "^[a-z]+\\.[a-z_]+$" },
    "jevKey": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "instructions": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "minProperties": 1 },
        { "type": "array", "minItems": 1 }
      ]
    },
    "noulCriteria": {
      "type": "object",
      "required": ["true", "false"],
      "additionalProperties": false,
      "properties": { "true": { "type": "string" }, "false": { "type": "string" } }
    },
    "checkBase": {
      "type": "object",
      "required": ["id", "version", "category", "weight", "kind", "fix_hint"],
      "properties": {
        "id": { "$ref": "#/$defs/checkId" },
        "version": { "type": "integer", "minimum": 1 },
        "category": { "$ref": "#/$defs/slug" },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "kind": { "enum": ["jev", "jev_dynamic", "rule"] },
        "applies_when": { "type": "array", "items": { "type": "string", "pattern": "^gate\\.[a-z_]+$" } },
        "fix_hint": { "type": "string", "minLength": 1 }
      }
    },
    "check": {
      "allOf": [{ "$ref": "#/$defs/checkBase" }],
      "oneOf": [
        { "$ref": "#/$defs/noulCheck" },
        { "$ref": "#/$defs/choiceCheck" },
        { "$ref": "#/$defs/scoreCheck" },
        { "$ref": "#/$defs/dynamicCheck" },
        { "$ref": "#/$defs/ruleCheck" }
      ]
    },
    "noulCheck": {
      "type": "object",
      "required": ["type", "instructions"],
      "properties": {
        "kind": { "const": "jev" },
        "type": { "const": "noul" },
        "instructions": { "$ref": "#/$defs/instructions" },
        "criteria": { "$ref": "#/$defs/noulCriteria" },
        "polarity": { "enum": ["positive", "negative"], "default": "positive" }
      }
    },
    "choiceCheck": {
      "type": "object",
      "required": ["type", "instructions", "criteria", "points"],
      "properties": {
        "kind": { "const": "jev" },
        "type": { "const": "choice" },
        "instructions": { "$ref": "#/$defs/instructions" },
        "criteria": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 255,
          "propertyNames": { "pattern": "^[a-z_]+$" },
          "additionalProperties": { "type": "string" }
        },
        "points": {
          "type": "object",
          "description": "Points per option in [0,1]; null marks a not-applicable escape option.",
          "additionalProperties": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }] }
        }
      }
    },
    "scoreCheck": {
      "type": "object",
      "required": ["type", "instructions", "criteria", "points"],
      "properties": {
        "kind": { "const": "jev" },
        "type": { "const": "score" },
        "instructions": { "$ref": "#/$defs/instructions" },
        "criteria": { "type": "array", "minItems": 2, "maxItems": 10, "items": { "type": "string" } },
        "points": { "const": "linear" }
      }
    },
    "dynamicCheck": {
      "type": "object",
      "required": ["type", "source", "key_template", "instructions_template", "aggregation"],
      "properties": {
        "kind": { "const": "jev_dynamic" },
        "type": { "const": "noul" },
        "source": { "const": "extracted_requirements" },
        "key_template": { "type": "string", "pattern": "\\{requirement_id\\}" },
        "instructions_template": { "$ref": "#/$defs/instructions" },
        "criteria": { "$ref": "#/$defs/noulCriteria" },
        "aggregation": { "const": "coverage_ratio" }
      }
    },
    "ruleCheck": {
      "type": "object",
      "required": ["rule"],
      "properties": {
        "kind": { "const": "rule" },
        "rule": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "sections_from"],
              "properties": { "type": { "const": "sections_present" }, "sections_from": { "type": "string" } }
            },
            {
              "type": "object",
              "required": ["type", "pattern", "full_points_at"],
              "properties": {
                "type": { "const": "count_pattern" },
                "pattern": { "type": "string" },
                "unique": { "type": "boolean" },
                "full_points_at": { "type": "integer", "minimum": 1 }
              }
            },
            {
              "type": "object",
              "required": ["type", "pattern"],
              "properties": {
                "type": { "const": "absent_pattern" },
                "pattern": { "type": "string" },
                "case_insensitive": { "type": "boolean" }
              }
            }
          ]
        }
      }
    }
  }
}
