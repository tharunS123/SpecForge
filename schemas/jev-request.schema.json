{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specforge.dev/schemas/jev-request.schema.json",
  "title": "Jev POST /v1/systemone request (as SpecForge sends it)",
  "description": "Mirrors https://docs.typesafe.ai/api. SpecForge always sends state as {user_request, specification} and pins a concrete model version.",
  "type": "object",
  "required": ["state", "model", "questions"],
  "additionalProperties": false,
  "properties": {
    "state": {
      "type": "object",
      "required": ["user_request", "specification"],
      "additionalProperties": false,
      "properties": {
        "user_request": { "type": "string", "minLength": 1 },
        "specification": { "type": "string", "minLength": 1 }
      }
    },
    "model": {
      "type": "string",
      "pattern": "^jev-\\d+\\.\\d+(\\.\\d+)?$",
      "description": "Pinned model version. Aliases like jev-latest are not allowed for scored runs."
    },
    "questions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9_]+$" },
      "additionalProperties": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "instructions": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "minProperties": 1 },
        { "type": "array", "minItems": 1 }
      ]
    },
    "question": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "instructions"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "noul" },
            "instructions": { "$ref": "#/$defs/instructions" },
            "criteria": {
              "type": "object",
              "properties": { "true": { "$ref": "#/$defs/instructions" }, "false": { "$ref": "#/$defs/instructions" } },
              "additionalProperties": false
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "instructions", "criteria"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "choice" },
            "instructions": { "$ref": "#/$defs/instructions" },
            "criteria": {
              "type": "object",
              "minProperties": 2,
              "maxProperties": 255,
              "additionalProperties": { "$ref": "#/$defs/instructions" }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "instructions", "criteria"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "score" },
            "instructions": { "$ref": "#/$defs/instructions" },
            "criteria": { "type": "array", "minItems": 2, "maxItems": 10, "items": { "$ref": "#/$defs/instructions" } }
          }
        }
      ]
    }
  }
}
